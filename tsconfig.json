{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2023",
        "lib": ["ES2023"],
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "types": ["node", "jest"]
    },
    "include": ["src/**/*.ts", "*.ts"]
}
