# Genere su .env con `npm run configurar`: crea contraseñas aleatorias seguras.
# Nunca suba .env al repositorio.
PUERTO=3000

# Cuenta administrativa de la base de datos (migraciones, respaldos, pruebas)
PGHOST=localhost
PGPORT=5432
PGDATABASE=sga
PGUSER=sga
PGPASSWORD=cambie-esta-contrasena

# Cuenta con la que la aplicación se conecta a la base (privilegios mínimos)
SGA_API_CONTRASENA=cambie-esta-contrasena

# Respaldos (sección 31). Guarde la frase también fuera de la computadora:
# sin ella no se puede restaurar ningún respaldo.
SGA_RESPALDO_CLAVE=cambie-esta-frase
SGA_RESPONSABLE=Nombre de quien ejecuta
